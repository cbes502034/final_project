# ======================================================================
# 家庭記帳 後端設定
# ----------------------------------------------------------------------
# 用法：
#   cd backend
#   python -m app.cli init-env        # 複製成 .env，順便產生 JWT_SECRET
#   python -m app.cli check-config    # 看哪些還沒填
#
# .env 已經寫進 .gitignore，不會被提交。**這個 .env.example 只能放空白範本，不能放真的值。**
# Render 上沒有 .env：到後台 Environment 頁面，用一樣的名字填。
# 前端要連哪個後端，改 frontend/index.html 的 <meta name="api-base">，不在這裡。
#
# 每一段歸誰管寫在段落標題。改自己那一段就好；共用的先在群組講一聲。
# 欄位的完整說明在 app/toolkit/config.py。
# ======================================================================


# ======================================================================
# 共用（認證 維護，四個領域都會用到）
# ======================================================================
# development / production
APP_ENV=development
# 本機跟正式環境一樣用 PostgreSQL，跑在 Docker 裡（docker-compose.yml 的 db）。
# python run.py 會自己把它開起來；帳號密碼只在你自己電腦上，不是機密。
# ⚠️ Render 上這一格由 render.yaml 自動接資料庫，不用自己填。
# 真的沒辦法裝 Docker 的話，暫時可以改成 sqlite:///./dev.db（程式兩種都能跑，但上線是 PostgreSQL）
DATABASE_URL=postgresql+psycopg://fambudget:devpassword@localhost:5432/fambudget
# True 會把 SQL 印出來，除錯用
DB_ECHO=false
DB_POOL_SIZE=5
# 允許哪些前端網域來打這個 API，逗號分隔。填錯前端會被瀏覽器擋住
# 5174 是 python run.py 起的前端；127.0.0.1 跟 localhost 算兩個來源，兩個都要寫
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://fambudget-web.onrender.com


# ======================================================================
# 認證　登入、JWT、忘記密碼寄信、平台管理員
# ======================================================================
# ⚠️ 必填、機密。init-env 會自動產生；手動產生：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# 註冊驗證信、重設密碼的連結幾分鐘後失效。要測「過期之後真的不能用」時暫時調短（例如 3），測完改回來
EMAIL_VERIFY_MINUTES=1440
PASSWORD_RESET_MINUTES=30

# 忘記密碼寄信（Brevo HTTP API）。⚠️ Render 免費方案擋掉了 SMTP 埠，不要改用 Gmail SMTP。
# 金鑰：Brevo 後台 → SMTP & API → API keys；寄件信箱要先在 Senders 驗證過。
# 填好之後試寄一封給自己：python -m app.toolkit.mailer --to 你的信箱
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=家庭記帳
# 重設密碼信裡的連結開頭。本機開發用 http://localhost:5174
APP_BASE_URL=http://localhost:5174

# 平台管理員的 email，逗號分隔。服務啟動時（以及 python -m app.cli make-admin）會把他們設成平台管理員
# ⚠️ 要用新註冊、沒有家庭也沒記過帳的帳號；已經有帳的帳號不會被設成管理員
ADMIN_EMAILS=
# 防濫用：登入失敗幾次鎖 15 分鐘、同一來源一小時最多註冊幾個、每人每天 AI 解析／產生建議的次數
LOGIN_MAX_FAILURES=5
REGISTER_PER_HOUR=5
AI_PARSE_PER_DAY=200
AI_ADVICE_PER_DAY=20


# ======================================================================
# 記帳　自然語言解析的模型服務（財務建議沒另外設定時也用這一組）
# ======================================================================
# 三種填法擇一（詳見 docs/03-LLM實作規劃.md）：
#   Claude   MODEL_PROVIDER=anthropic，填 MODEL_API_KEY，MODEL_BASE_URL 留空
#            MODEL_NAME 不是 claude- 開頭時自動用 claude-opus-5-5；想省錢可改 claude-haiku-4-5
#   OpenAI   MODEL_PROVIDER=openai，MODEL_BASE_URL=https://api.openai.com，填 MODEL_API_KEY 與 MODEL_NAME
#   自己的   MODEL_PROVIDER=openai，MODEL_BASE_URL=Hugging Face Space 的網址，MODEL_NAME=qwen2.5-1.5b-fambudget
# 都留空時解析與建議的路由回 503，前端照樣能用（解析改用規則）
MODEL_PROVIDER=openai
MODEL_BASE_URL=
# OpenAI／Anthropic 的 API key，或私有 Space 的 token。⚠️ 機密，只填在這裡和 Render 後台
MODEL_API_KEY=
MODEL_NAME=qwen2.5-1.5b-fambudget
# 只有 Claude 用：思考深度 low／medium／high。解析是抽欄位，low 最快
MODEL_EFFORT=low
# 0＝用程式給的長度；本機跑推理型模型（Ollama 的 deepseek-r1）要調高，例如 4096
MODEL_MAX_TOKENS=0
# 商業 API 偶爾要十幾秒，建議 60
MODEL_TIMEOUT_SECONDS=60


# ======================================================================
# 數字　財務建議、儲蓄目標
# ======================================================================
# 建議想用另一組模型時才填；每一個留空就沿用上面記帳那一組
ADVICE_PROVIDER=
ADVICE_BASE_URL=
# ⚠️ 機密
ADVICE_API_KEY=
ADVICE_MODEL_NAME=
# 只有 Claude 用：建議要寫成人話，比解析多想一點
ADVICE_EFFORT=medium
# 支出達可支配上限的幾成算「接近」、幾成算「超過」。改了要同步 frontend/js/data.js 的 savingsRule
SAVINGS_WARN_RATIO=0.8
SAVINGS_OVER_RATIO=1.0


# ======================================================================
# 家庭　邀請、通知
# ======================================================================
# 可以填小數：測試過期時暫時設 0.002（約 3 分鐘），測完改回 7
INVITE_TTL_DAYS=7
