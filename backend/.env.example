# 複製成 .env 後填入實際值。.env 已寫進 .gitignore，不會被提交。
#
# 必填的兩個（沒填服務起不來，這是刻意的設計）
DATABASE_URL=postgresql+psycopg://fambudget:devpassword@localhost:5432/fambudget
JWT_SECRET=請改成長度足夠的隨機字串，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"

# 認證相關（有預設值，可以不填）
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# 允許哪些前端網域來打這個 API，逗號分隔。填錯前端會被瀏覽器擋住。
ALLOWED_ORIGINS=http://localhost:5174,https://llm-capstone-top20.onrender.com

# 我們自己微調的 Qwen2.5-1.5B 模型服務（GGUF + llama.cpp on HF Space）。
# 留空時 services/llm/parse.py 會回傳形狀正確的假資料，
# 讓前後端可以先串起來，不必等模型訓練完。
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=30

# 寄信（忘記密碼）。用 Brevo 的 HTTP API——Render 免費方案擋掉了 SMTP 埠。
# 金鑰在 Brevo 後台 → SMTP & API → API keys；寄件信箱要先在 Brevo 的 Senders 驗證過。
# 填好之後試寄一封給自己：python -m app.toolkit.mailer --to 你的信箱
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=家庭記帳
# 重設密碼信裡的連結開頭。本機開發用 http://localhost:5174
APP_BASE_URL=http://localhost:5174
